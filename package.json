{
  "name": "upkeep-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "verify": "npm run test && npm run build && npm run check:seo",
    "check:indexnow": "node scripts/indexnow.mjs --check",
    "indexnow:dry-run": "node scripts/indexnow.mjs --dry-run",
    "indexnow:submit": "node scripts/indexnow.mjs --submit",
    "check:theme": "node scripts/check-theme.mjs",
    "check:queue": "node scripts/validate-production-queue.mjs",
    "check:media": "node scripts/check-media.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
