---
import BrandMark from "../components/BrandMark.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";
interface Crumb { title: string; href?: string; }
interface Props { title: string; description: string; breadcrumbs?: Crumb[]; type?: "website" | "article"; }
const { title, description, breadcrumbs = [], type = "website" } = Astro.props;
const rawOrigin = import.meta.env.PUBLIC_SITE_URL?.trim();
const validOrigin = rawOrigin && /^https:\/\/[a-z0-9.-]+(?::[0-9]+)?\/?$/i.test(rawOrigin) ? rawOrigin.replace(/\/$/, "") : "";
const canonical = validOrigin ? new URL(Astro.url.pathname, validOrigin).href : undefined;
// Build fingerprint: IndexNow automation waits for this exact deployed commit before POSTing.
const buildEnv = (globalThis as typeof globalThis & {process?: {env?: Record<string,string | undefined>}}).process?.env ?? {};
const cfCommit = buildEnv.CF_PAGES_COMMIT_SHA || "";
const deployedCommit = validOrigin && buildEnv.CF_PAGES_BRANCH === "main" && /^[a-f0-9]{40}$/.test(cfCommit) ? cfCommit : "";
const brand = "Upkeep Atlas";
const fullTitle = title === brand ? brand + " | Home maintenance, made manageable" : title + " | " + brand;
const schema = validOrigin ? [
  { "@context": "https://schema.org", "@type": "WebSite", name: brand, url: validOrigin + "/", description: "Practical home maintenance planners, checklists and tools." },
  ...(breadcrumbs.length ? [{ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: validOrigin + "/" },
    ...breadcrumbs.map((b,i)=>({ "@type": "ListItem", position: i+2, name: b.title, item: new URL(b.href || Astro.url.pathname, validOrigin).href }))
  ] }] : [])
] : [];
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#F7F6F2" />
  <!-- Set the theme before the first paint so there is no light-mode flash. -->
  <script is:inline>
    (() => {
      let saved = null;
      try { saved = localStorage.getItem("upkeepatlas-theme"); } catch { /* Storage may be disabled. */ }
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = saved === "dark" || saved === "light" ? saved : systemDark ? "dark" : "light";
      document.documentElement.dataset.theme = theme;
      const color = document.querySelector('meta[name="theme-color"]');
      if (color) color.setAttribute("content", theme === "dark" ? "#151C19" : "#F7F6F2");
    })();
  </script>
  <meta name="generator" content="Astro" />
  {deployedCommit && <meta name="upkeepatlas-deploy-commit" content={deployedCommit} />}
  <!-- Ownership verification: Google Search Console and Bing Webmaster Tools. -->
  <meta name="google-site-verification" content="dLBYqjQSU_b8qIgIePwzoGsC7t8yMRd_7clA3LDZzvg" />
  <meta name="msvalidate.01" content="6F5CEF54439CF26D57A6D6556901350F" />
  <!-- AdSense account recognition; ads are only enabled on the configured production origin. -->
  <meta name="google-adsense-account" content="ca-pub-3399213817491318" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={canonical ? "index,follow,max-image-preview:large" : "noindex,nofollow"} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:site_name" content={brand} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {validOrigin && <meta property="og:image" content={validOrigin + "/social-card.svg"} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {validOrigin && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3399213817491318" crossorigin="anonymous"></script>}
  {schema.map((item)=><script type="application/ld+json" set:html={JSON.stringify(item)} />)}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-shell">
    <header class="site-header">
      <div class="container header-inner">
        <BrandMark />
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="/maintenance-calendar/">The Planner</a><a href="/checklists/">Checklists</a><a href="/guides/">Field Notes</a><a href="/calculators/">Calculators</a>
        </nav>
        <a class="header-cta" href="/maintenance-calendar/">Build your plan <span aria-hidden="true">↗</span></a>
        <ThemeToggle />
        <details class="mobile-menu">
          <summary aria-label="Open navigation">Menu <span aria-hidden="true">☰</span></summary>
          <nav aria-label="Mobile navigation"><a href="/maintenance-calendar/">The Planner</a><a href="/checklists/">Checklists</a><a href="/guides/">Field Notes</a><a href="/calculators/">Calculators</a><a href="/about/">About</a><a href="/contact/">Contact</a></nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-primary">
          <div class="footer-brand"><BrandMark /><p>Quietly useful tools for looking after the place you call home.</p></div>
          <div class="footer-links"><div><strong>Explore</strong><a href="/maintenance-calendar/">Maintenance planner</a><a href="/checklists/">Checklists</a><a href="/calculators/">Calculators</a><a href="/guides/">Field notes</a></div><div><strong>Our approach</strong><a href="/about/">About Upkeep Atlas</a><a href="/editorial-policy/">Editorial standards</a><a href="/privacy/">Privacy</a><a href="/contact/">Contact us</a></div></div>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Upkeep Atlas</span><span>Made for the everyday work of caring for a home.</span></div>
      </div>
    </footer>
  </div>
</body>
</html>
