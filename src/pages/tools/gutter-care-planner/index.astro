---
import Base from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import {OBSERVATIONS} from "../../../lib/gutter-care.mjs";
const crumbs=[{title:"Calculators",href:"/calculators/"},{title:"Gutter care planner"}];
---
<Base title="Ground-Level Gutter Inspection Checklist & Planner" description="Record visible gutter and downspout concerns safely from ground level, create a printable follow-up plan, and know when to call a professional." breadcrumbs={crumbs}>
<section class="page-head"><div class="container"><Breadcrumbs items={crumbs}/><span class="eyebrow">EXTERIOR · OBSERVATION FIRST</span><h1>Gutter care starts <em class="serif" style="color:var(--pine)">on the ground.</em></h1><p class="lede">Record what you can safely see, then print a clear list for a gutter or drainage professional. This is a visual observation aid—not a roof inspection or repair tutorial.</p></div></section>
<section class="section-small rule-top"><div class="container narrow">
<div class="note caution"><strong>Stay on safe ground.</strong> Do not use ladders, climb roofs, lean from windows, touch electrical lines, walk through floodwater, stand under hanging ice, or go outside during severe weather. If the property is unsafe, skip the walk-around and contact a qualified professional or emergency services as appropriate.</div>
<form id="gutter-form" class="tool-shell">
<div class="tool-head"><span class="eyebrow">YOUR OBSERVATION RECORD</span><h2>What can you see safely?</h2></div>
<div class="tool-grid"><div class="field"><label for="gutter-date">Observation date (optional)</label><input id="gutter-date" type="date"/></div><div class="field"><label for="gutter-exposure">Most relevant condition</label><select id="gutter-exposure"><option value="mixed">Mixed or unsure</option><option value="trees">Nearby trees / leaf fall</option><option value="rain">Frequent heavy rain</option><option value="freeze">Freezing / snow / ice</option></select></div></div>
<fieldset class="gutter-choices"><legend>Visible signs (check all that apply; leave blank if none seen)</legend>{OBSERVATIONS.map(item=><label><input type="checkbox" name="finding" value={item.id}/><span>{item.label}</span></label>)}</fieldset>
<div class="field"><label for="gutter-location">Location / notes (optional, max 300 characters)</label><textarea id="gutter-location" maxlength="300" rows="3" placeholder="Example: west corner near driveway; observed from porch"></textarea></div>
<div class="tool-actions no-print"><button class="button" type="submit">Build observation record</button><button class="button light" type="reset">Clear form and record</button></div><p id="gutter-error" class="error" role="alert" hidden></p>
</form>
<section id="gutter-output" class="tool-shell" aria-labelledby="gutter-result-heading"><span class="eyebrow">PRINTABLE FOLLOW-UP</span><h2 id="gutter-result-heading">Ground-level observation report</h2><p id="gutter-summary" role="status" aria-live="polite">Select observations and build a report. No gutter condition has been assessed yet.</p><p id="gutter-context"></p><ol id="gutter-results"><li>Example: If water pools near the foundation, record its location and ask a drainage professional to evaluate the discharge.</li></ol><p id="gutter-notes"></p><div class="tool-actions no-print"><button class="button light" type="button" id="gutter-print">Print or save as PDF</button></div></section>
<div class="prose"><h2>What a ground-level check can tell you</h2><p>From a safe, stable place, you may notice sagging gutters, loose downspouts, staining, visible leaves or plants, and pooling near a foundation. During ordinary rain, you may notice overflow <strong>from indoors or sheltered ground</strong>; never go out in dangerous weather to make a check. An unobstructed view does not establish that a gutter is clear inside or properly pitched.</p><p><strong>Example:</strong> Choose “water pools” and “frequent heavy rain” to get a follow-up note about the drainage outlet, not a diagnosis or a suggested excavation. Marking nothing produces a record of no visible concerns, not a pass certificate.</p><h2>When should you revisit the record?</h2><p>Consider a new safe visual check when you notice overflow, after leaf fall or after significant weather once conditions are safe. There is no universal interval: trees, local rainfall, snow, gutter guards, building height and property access all change what can be seen. Ask a qualified gutter professional about inaccessible sections, persistent leaks, sagging, drainage near the foundation or ice hazards.</p><h2>Sources and related tools</h2><p>The <a href="https://www.epa.gov/mold/brief-guide-mold-moisture-and-your-home">EPA moisture guide</a> explains why ongoing moisture needs attention. <a href="https://www.ready.gov/floods">Ready.gov flood safety</a> and <a href="https://www.ready.gov/winter-weather">winter-weather preparedness</a> describe hazardous weather precautions. The <a href="https://www.cdc.gov/niosh/falls/about/index.html">CDC/NIOSH falls information</a> provides context for avoiding fall exposure. Sources reviewed November 8, 2026.</p><p>Use the <a href="/tools/seasonal-maintenance-builder/">seasonal maintenance builder</a> for broader planning, the <a href="/tools/maintenance-log/">home maintenance log</a> for completed service, or <a href="/calculators/">all tools</a>.</p><p class="small muted">This page does not save or upload notes. Data stays in the current page until reset or closed. Print uses your browser print dialog. No contractor or inspection is automatically booked.</p></div>
</div></section>
<style>.gutter-choices{border:1px solid var(--line);padding:1rem;display:grid;gap:.75rem;margin:1rem 0}.gutter-choices legend{font-weight:700;padding:0 .3rem}.gutter-choices label{display:flex;align-items:flex-start;gap:.65rem}.gutter-choices input{width:1.15rem;height:1.15rem;flex-shrink:0}.gutter-choices span{line-height:1.5}#gutter-results li{padding:.65rem 0;break-inside:avoid}#gutter-notes{white-space:pre-wrap;overflow-wrap:anywhere}@media print{#gutter-form,.no-print{display:none!important}#gutter-output{border:0;padding:0}#gutter-results li{color:#222!important}}</style>
<script>
import {buildGutterPlan} from "../../../lib/gutter-care.mjs";
const form=document.querySelector<HTMLFormElement>("#gutter-form");
const summary=document.querySelector<HTMLElement>("#gutter-summary");
const context=document.querySelector<HTMLElement>("#gutter-context");
const results=document.querySelector<HTMLOListElement>("#gutter-results");
const notes=document.querySelector<HTMLElement>("#gutter-notes");
const error=document.querySelector<HTMLElement>("#gutter-error");
form?.addEventListener("submit",event=>{event.preventDefault();try{const observed=[...form.querySelectorAll<HTMLInputElement>('input[name="finding"]:checked')].map(x=>x.value);const exposure=form.querySelector<HTMLSelectElement>("#gutter-exposure")?.value||"mixed";const date=form.querySelector<HTMLInputElement>("#gutter-date")?.value||"";const report=buildGutterPlan({observed,exposure,date});if(summary)summary.textContent=report.summary;if(context)context.textContent=(date?"Observed "+date+". ":"")+report.exposureNote;if(results){results.replaceChildren();for(const item of report.findings){const li=document.createElement("li");const title=document.createElement("strong");title.textContent=item.label;const p=document.createElement("p");p.textContent=item.detail;li.append(title,p);results.append(li);}if(!report.findings.length){const li=document.createElement("li");li.textContent="No visible concerns noted; hidden problems are still possible.";results.append(li);}}if(notes)notes.textContent=form.querySelector<HTMLTextAreaElement>("#gutter-location")?.value.trim()||"";if(error)error.hidden=true;}catch(e){if(error){error.textContent=e instanceof Error?e.message:"Please check your entries.";error.hidden=false;}}});
form?.addEventListener("reset",()=>{if(summary)summary.textContent="Form cleared. No gutter condition has been assessed.";if(context)context.textContent="";if(results)results.replaceChildren();if(notes)notes.textContent="";if(error)error.hidden=true;});
document.querySelector("#gutter-print")?.addEventListener("click",()=>window.print());
</script>
</Base>
