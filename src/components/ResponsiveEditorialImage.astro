---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
}
const { src, alt, caption, sizes = "(max-width: 48rem) 100vw, 760px", widths = [320, 640, 960, 1280], loading = "lazy" } = Astro.props;
if (!alt.trim() && !caption) {
  // Empty alt is valid for decorative imagery; do not treat it as missing.
}
---
<figure class="editorial-media">
  <Image src={src} alt={alt} widths={widths.filter(width => width <= src.width)} sizes={sizes} loading={loading} decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .editorial-media { margin: 1.5rem 0; }
  .editorial-media :global(img) { display:block; width:100%; height:auto; }
  figcaption { margin-top:.5rem; font-size:.875rem; color:var(--muted); }
</style>
