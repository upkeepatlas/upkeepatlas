---
interface Crumb { title: string; href?: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
{items.length > 0 && <nav class="crumbs" aria-label="Breadcrumb">
  <ol><li><a href="/">Home</a></li>
  {items.map((item) => <li aria-current={item.href ? undefined : "page"}>{item.href ? <a href={item.href}>{item.title}</a> : <span>{item.title}</span>}</li>)}
  </ol>
</nav>}
<style>
.crumbs{margin:0 0 1.55rem;color:var(--muted);font-size:.77rem;letter-spacing:.035em}
.crumbs ol{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem;list-style:none;padding:0;margin:0}
.crumbs li+li:before{content:"/";padding-right:.65rem;color:#A1AAA3}
.crumbs a{text-decoration:none;color:inherit}.crumbs a:hover{text-decoration:underline}
</style>
