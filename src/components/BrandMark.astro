---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<a class="brand" href="/" aria-label="Upkeep Atlas — home">
  <svg class="brand-symbol" viewBox="0 0 46 46" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="44" height="44" rx="9" fill="#234238"/>
    <path d="M9.5 21.8 23 10.5 36.5 21.8M14 23v14h18V23" stroke="#F3F6EE" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <path d="M18 31c5-6.5 11-5.5 12-5.5-1 7.2-6.6 9.3-12 5.5" fill="#A9C8AE"/>
  </svg>
  {!compact && <span class="brand-name">Upkeep <em>Atlas</em></span>}
</a>
<style>
.brand{display:inline-flex;align-items:center;gap:.72rem;text-decoration:none;color:inherit}
.brand-symbol{width:38px;height:38px;flex:none}
.brand-name{font-family:Georgia, 'Times New Roman',serif;letter-spacing:-.055em;font-size:1.54rem;white-space:nowrap}
.brand-name em{font-weight:400;font-style:italic;color:var(--pine)}
</style>
